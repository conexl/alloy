# Environment variables for docker-compose

# VK Bot
VK_GROUP_TOKEN=your_group_token_here
VK_GROUP_ID=12345678
VK_SECRET=
VK_CONFIRMATION=
ADMIN_VK_IDS=123456789,987654321

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tender

# Email (SMTP/IMAP) — for dev use MailHog/MailDev values
SMTP_HOST=smtp
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@tender.local

IMAP_HOST=imap
IMAP_PORT=993
IMAP_USER=test@localhost
IMAP_PASS=test
IMAP_FOLDER=INBOX
IMAP_EXTRA_FOLDERS=Spam,Junk

# OpenRouter (optional, for AI replies)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-5.2

# Yandex XML API (for supplier-finder)
YANDEX_XML_USER=your_yandex_login
YANDEX_XML_KEY=your_yandex_api_key