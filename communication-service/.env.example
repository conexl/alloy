# Redis
REDIS_URL=redis://localhost:6379

# PostgreSQL
DB_DSN=postgres://user:pass@localhost:5432/dbname

# SMTP (MailHog для dev)
SMTP_HOST=smtp
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@tender.local

# IMAP (MailDev для dev)
IMAP_HOST=imap
IMAP_PORT=993
IMAP_USER=test@localhost
IMAP_PASS=test
IMAP_POLL_INTERVAL=300
IMAP_FOLDER=INBOX

# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-xxx
OPENROUTER_MODEL=openai/gpt-5.2

# Поведение
MAX_EMAILS_PER_ITEM=5
SMTP_DELAY=1.0