-- Migration: Create tables for VK bot
-- Created: 2025-05-03

CREATE TABLE IF NOT EXISTS vk_users (
    vk_id BIGINT PRIMARY KEY,
    vk_name VARCHAR(255) NOT NULL,
    is_active BOOLEAN DEFAULT true,
    created_at TIMESTAMP DEFAULT NOW()
);

CREATE TABLE IF NOT EXISTS quote_responses (
    id SERIAL PRIMARY KEY,
    user_id BIGINT NOT NULL REFERENCES vk_users(vk_id) ON DELETE CASCADE,
    item_id INTEGER NOT NULL REFERENCES items(id) ON DELETE CASCADE,
    supplier_id INTEGER NOT NULL REFERENCES suppliers(id) ON DELETE CASCADE,
    price NUMERIC(12,2),
    delivery_days INTEGER,
    is_accepted BOOLEAN NOT NULL,
    comment TEXT,
    responded_at TIMESTAMP DEFAULT NOW(),
    created_at TIMESTAMP DEFAULT NOW(),
    UNIQUE(user_id, item_id, supplier_id)
);

CREATE INDEX IF NOT EXISTS idx_quote_responses_user_id ON quote_responses(user_id);
CREATE INDEX IF NOT EXISTS idx_quote_responses_item_id ON quote_responses(item_id);
CREATE INDEX IF NOT EXISTS idx_quote_responses_supplier_id ON quote_responses(supplier_id);

-- Add created_by_vk to rfq_requests if not exists
ALTER TABLE rfq_requests ADD COLUMN IF NOT EXISTS created_by_vk BIGINT REFERENCES vk_users(vk_id);